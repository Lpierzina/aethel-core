package aethel:core@0.1.0;

interface types {
  /// Closed set of failure reasons across all aethel:core operations.
  /// A flat variant — no operation's error nests another operation's error.
  ///
  /// Not every case has a producer today. Five do:
  /// `invalid-input-length`, `serialization-error`, `threshold-not-met`,
  /// `rejection-sampling-failed`, and `invalid-share-set`. The other three are
  /// reserved for the predicate relation and are marked below; a caller
  /// written against this world today will never observe them.
  ///
  /// They are declared rather than omitted because adding a case to a
  /// `variant` is itself a breaking change for callers that match
  /// exhaustively, and the predicate work is the next step on this surface.
  /// Reserving them now means that work does not force a second break. The
  /// split is pinned by `component_error_variant_reachability` in
  /// `tests/component_execution.rs`, so it cannot quietly stop being true.
  variant identity-error {
    /// A byte-slice input was too short or malformed for the operation.
    invalid-input-length,
    /// A proof or projection could not be parsed into its declared shape.
    serialization-error,
    /// Rejection sampling exhausted its fixed iteration ceiling, so no proof
    /// exists to return. Emitting the last rejected candidate instead is how a
    /// sigma protocol leaks its secret, so the operation refuses.
    rejection-sampling-failed,
    /// RESERVED, no producer today. A response vector's infinity norm exceeded
    /// the rejection bound. Verification reports a well-formed proof that does
    /// not verify as `ok(false)`, never as an error, because that is a verdict
    /// rather than a failure to reach one. Held for the predicate relation,
    /// which must distinguish a range proof whose response is out of bounds
    /// from one that simply does not hold.
    norm-bound-violation,
    /// RESERVED, no producer today. A recomputed Fiat-Shamir challenge did not
    /// match the proof's challenge. See `norm-bound-violation`.
    challenge-mismatch,
    /// RESERVED, no producer today. A disclosed attribute did not match its
    /// vector commitment. See `norm-bound-violation`.
    invalid-attribute-commitment,
    /// Fewer than the threshold number of shares were supplied.
    threshold-not-met,
    /// The supplied shares are not a valid share set: an evaluation index
    /// appears more than once, or more shares were supplied than the scheme
    /// issues. Lagrange interpolation over repeated points is undefined, and
    /// answering anyway means returning a value that is not the shared secret,
    /// so the operation refuses rather than reconstructing.
    ///
    /// Appended last deliberately: a `variant` is ordinal-encoded, so inserting
    /// a case anywhere but the end silently renumbers every case after it for
    /// callers compiled against an earlier version of this world.
    invalid-share-set,
  }

  /// Named disclosure slots. Never a raw bitmask on the wire.
  flags disclosure-attributes {
    attribute0,
    attribute1,
    attribute2,
    attribute3,
    attribute4,
    attribute5,
    attribute6,
    attribute7,
  }
}

interface identity {
  use types.{identity-error, disclosure-attributes};

  /// A context-bound projection of a master identity at context τ.
  ///
  /// `matrix-a` is gone from this record. It used to carry the context matrix
  /// `A`, which was a pure function of τ; that is what made repeated projection
  /// at one τ recover the master secret, because every sample shared one `A` and
  /// averaging away the centered error left `A·s`. `A` is now derived from τ and
  /// a per-projection `salt`, so two projections at one τ are independent
  /// samples.
  ///
  /// The matrix is not carried because it is fully determined by `tau` and
  /// `salt`. Sending it would be redundant bytes a verifier would then have to
  /// trust or cross-check; deriving it makes an inconsistent `A` unrepresentable
  /// rather than merely detectable. This also shrinks the record substantially.
  record ephemeral-projection {
    tau: list<u8>,
    /// Public per-projection salt, 32 bytes. Derived inside the component from
    /// the caller's projection randomness. Fresh randomness gives a fresh salt,
    /// which is what makes τ reuse safe.
    salt: list<u8>,
    public-b: list<u32>,
  }

  /// A zero-knowledge proof of ownership over an ephemeral-projection.
  record zk-identity-proof {
    commitment-w: list<u32>,
    challenge-c: list<u32>,
    response-z: list<u32>,
  }

  /// Project a master identity (from secret key material) at context τ.
  ///
  /// `randomness` MUST be at least 32 bytes of fresh, secret entropy, distinct
  /// per projection. It does two jobs: it seeds the error term e_τ that makes
  /// b_τ an M-LWE sample rather than an exact linear image of the secret, and it
  /// derives the public salt that makes the context matrix `A` specific to this
  /// projection.
  ///
  /// τ no longer has to be single-use. It used to: `A` was a function of τ
  /// alone, so repeated projection at one τ produced samples sharing one `A`,
  /// and averaging roughly 64 of them recovered the secret however fresh each
  /// error term was. With `A` salted per projection there is nothing to average.
  ///
  /// The obligation has moved onto `randomness`, which is the better place for
  /// it: a caller generates their own randomness, whereas τ is often handed to
  /// them and collides across users by construction (the canonical τ is a block
  /// height). Reusing `randomness` for two projections of one identity at one τ
  /// reinstates the shared `A`.
  plp-project-at-context: func(secret: list<u8>, tau: list<u8>, randomness: list<u8>) -> result<ephemeral-projection, identity-error>;

  /// Prove identity ownership at context τ.
  ///
  /// `randomness` MUST be the same value passed to `plp-project-at-context` for
  /// this τ. The proof is computed against the projection's context matrix `A`,
  /// and `A` is now derived from τ and a salt that comes from this randomness,
  /// so a proof built under different randomness is a proof about a different
  /// `A` and will not verify. This parameter is new: `A` used to be recoverable
  /// from τ alone, which is exactly the property that made τ reuse unsafe.
  plp-prove-identity: func(secret: list<u8>, tau: list<u8>, randomness: list<u8>) -> result<zk-identity-proof, identity-error>;

  /// Verify a ZK identity proof against a projection.
  plp-verify: func(projection: ephemeral-projection, proof: zk-identity-proof) -> result<bool, identity-error>;

  /// An identity whose secret key material never leaves the component.
  ///
  /// The free functions above take `secret: list<u8>`, which means the caller
  /// holds the master secret and it crosses this boundary on every call. That
  /// contradicts the charter's "no private key material crosses out of L1", and
  /// there was no way to *create* an identity at all: `plp-project-at-context`
  /// can only project a secret someone else already generated.
  ///
  /// This resource is the answer to both. The secret is derived inside the
  /// component and stays here; only the public key, projections and proofs come
  /// out.
  resource master-identity {
    /// Derive an identity from caller-supplied entropy.
    ///
    /// Requires at least 32 bytes. The entropy is NOT the key: it is stretched
    /// through SHAKE-256 with domain separation, and the ML-DSA-65 signing key
    /// and the PLP master seed are derived from that stream. Deterministic, so
    /// the same entropy always yields the same identity.
    generate: static func(entropy: list<u8>) -> result<master-identity, identity-error>;

    /// The ML-DSA-65 public key. Safe to publish, and the only key material
    /// that crosses this boundary.
    public-key: func() -> list<u8>;

    /// Sign a message. FIPS 204 deterministic variant, so no randomness is
    /// needed at call time.
    sign: func(message: list<u8>) -> result<list<u8>, identity-error>;

    /// Project this identity at context tau. See `plp-project-at-context` for
    /// what `randomness` must be.
    project-at-context: func(tau: list<u8>, randomness: list<u8>) -> result<ephemeral-projection, identity-error>;

    /// Prove ownership of this identity at context tau.
    ///
    /// `randomness` MUST be the same value passed to `project-at-context` for
    /// this tau. See `plp-prove-identity` for why.
    prove: func(tau: list<u8>, randomness: list<u8>) -> result<zk-identity-proof, identity-error>;

    /// Seal this identity so it can be stored and loaded again.
    ///
    /// `key` MUST be at least 32 bytes of high-entropy key material: a key from
    /// an OS keychain, an HSM, or a stored random value. It is NOT a password.
    /// A human-chosen password needs a slow, memory-hard KDF to survive offline
    /// guessing, and this component does not provide one. Run a real password
    /// KDF first and pass its output here.
    ///
    /// Deterministic: sealing the same identity under the same key twice yields
    /// identical bytes.
    export-sealed: func(key: list<u8>) -> result<list<u8>, identity-error>;

    /// Open a sealed identity.
    ///
    /// Returns `err` for a blob that is malformed, truncated, of an unknown
    /// version, or sealed under a different key. Those are deliberately
    /// indistinguishable to the caller.
    import-sealed: static func(sealed: list<u8>, key: list<u8>) -> result<master-identity, identity-error>;
  }

  /// A SAAP presentation: selective disclosure over an issued credential,
  /// anchored on the holder's PLP projection.
  ///
  /// Polynomial vectors are flattened into a single list of coefficients
  /// rather than nested lists, because the dimensions are fixed by the
  /// parameter set and a nested list would let a caller supply a ragged one.
  record saap-presentation {
    /// The context this presentation was made for.
    tau: list<u8>,
    /// Which attribute slots are disclosed.
    disclosed: disclosure-attributes,
    /// Values of the disclosed slots. Hidden slots read zero and mean nothing.
    disclosed-values: list<u64>,
    /// The blinded credential commitment, fresh for this presentation.
    t-blind: list<s32>,
    /// Fiat-Shamir challenge.
    challenge: list<s32>,
    /// Response for the commitment randomness.
    z-r: list<s32>,
    /// Response for the message slots.
    z-m: list<s32>,
    /// Response for the identity secret.
    z-s: list<s32>,
    /// Response for the projection error term.
    z-e: list<s32>,
  }

  /// The public half of an issuer's key pair.
  ///
  /// An issuer's authority lives in its seed. This is everything a verifier
  /// needs and nothing that lets it issue: `saap-verify-presentation` takes
  /// these parameters, `credential.issue` takes the seed, and the two are
  /// deliberately different types so a verifier cannot be wired to the wrong
  /// half by accident.
  ///
  /// # What holding these grants
  ///
  /// Verification, and the ability to recognise which issuer a presentation was
  /// made under. Deriving them from a seed is one-way: the seed is hashed
  /// through SHAKE-256, so recovering it from the published bytes is a preimage
  /// search. Holding these does not let you recover the seed.
  ///
  /// # What holding these does NOT grant
  ///
  /// These parameters leak nothing about the seed, and they do not let their
  /// holder call `credential.issue`, which takes the seed. What they do not do
  /// is make forgery hard for someone who does not go through this world.
  ///
  /// Issuance here is `t_cred = B_1 · r + (0 ‖ m)`, and the verification
  /// relation checks that a presentation opens to a short preimage under `B_1`.
  /// It does not check that an issuer authorised the attribute values. Anyone
  /// holding these parameters can construct that opening with their own tooling
  /// over their own identity, with attributes of their choosing, and it will
  /// verify. The issuer's ML-DSA signature over the credential, which is what
  /// would close this, is not shipped.
  ///
  /// So the separation these parameters buy is real but bounded: a verifier
  /// that holds them gains no power to issue against anyone else's identity,
  /// and a compromised verifier does not compromise the issuer. Holders are a
  /// different matter, and a holder must hold these to present at all.
  /// Deployments where holders are not trusted to self-assert their own
  /// attributes need issuer-authenticated issuance. `docs/ISSUER-AUTHENTICATION.md`
  /// states the gap and the construction that closes it.
  resource issuer-public-parameters {
    /// Derive the public parameters for the issuer identified by `issuer-seed`.
    ///
    /// `issuer-seed` MUST be at least 32 bytes. It is the issuer's secret and
    /// does not leave with the result.
    derive: static func(issuer-seed: list<u8>) -> result<issuer-public-parameters, identity-error>;

    /// The published form, 32 bytes. This is what travels to every verifier and
    /// what a relying party pins.
    serialize: func() -> list<u8>;

    /// Reconstruct published parameters. Round-trips with `serialize`.
    ///
    /// Every 32-byte string names some parameter set, so this rejects only a
    /// wrong length. It cannot tell you that the bytes are the issuer you meant:
    /// that is what pinning them over a trusted channel is for.
    deserialize: static func(bytes: list<u8>) -> result<issuer-public-parameters, identity-error>;
  }

  /// A credential issued over an identity.
  ///
  /// Holds the commitment randomness and the attribute values, so it is secret
  /// material and stays inside the component for the same reason
  /// `master-identity` does. Issue once, present many times.
  resource credential {
    /// Issue a credential binding `attributes` to the holder's identity.
    ///
    /// The holder's master secret occupies a reserved slot and is never
    /// disclosable. It is what ties the credential to one identity: a
    /// presentation can only be produced by someone who also satisfies the
    /// identity-linkage relation for the same secret.
    /// `issuer-seed` is the **secret** half of the issuer's key pair and MUST be
    /// at least 32 bytes. Whoever holds it can issue credentials under this
    /// issuer. It stays on the issuing side; a verifier takes
    /// `issuer-public-parameters` instead, derived from this seed.
    issue: static func(holder: borrow<master-identity>, issuer-seed: list<u8>, attributes: list<u64>, issuance-randomness: list<u8>) -> result<credential, identity-error>;

    /// Produce a presentation disclosing the selected attributes.
    ///
    /// `blinding-randomness` MUST be fresh per presentation: it is what makes
    /// two showings of the same credential unlinkable. `projection-randomness`
    /// is the same value used to build the holder's projection at this context,
    /// and is needed to re-derive the projection error term as a witness.
    present: func(holder: borrow<master-identity>, tau: list<u8>, projection-randomness: list<u8>, disclosed: disclosure-attributes, blinding-randomness: list<u8>, presentation-randomness: list<u8>) -> result<saap-presentation, identity-error>;
  }

  /// Verify a SAAP presentation against a holder's projection.
  ///
  /// `tau` is supplied by the verifier and must match the one carried in the
  /// presentation. A presentation is not allowed to certify its own context.
  ///
  /// Returns `ok(false)` for a well-formed presentation that does not verify,
  /// and `err` only for input that cannot be processed.
  /// `issuer` is the **public** half of the issuer's key pair. Verification
  /// needs no secret, so this function takes none: a public verifying endpoint
  /// can hold these parameters in reachable memory, and issuer and verifier can
  /// be separate organisations. There is no seed-taking verification entry
  /// point, deliberately.
  saap-verify-presentation: func(issuer: borrow<issuer-public-parameters>, presentation: saap-presentation, projection: ephemeral-projection, tau: list<u8>) -> result<bool, identity-error>;

  /// Verify an ML-DSA-65 signature.
  ///
  /// A free function, not a method: verification needs only public material, so
  /// requiring a `master-identity` would imply the verifier holds a secret it
  /// neither needs nor can have.
  ///
  /// Returns `ok(false)` for a well-formed signature that does not verify, and
  /// `err` only for input that cannot be parsed.
  verify-signature: func(public-key: list<u8>, message: list<u8>, signature: list<u8>) -> result<bool, identity-error>;

  /// Verify from `aethel-plp-1` wire bytes, binding the verifier's own
  /// context (A-4).
  ///
  /// Decodes both the `projection` and `proof` `aethel-plp-1` envelopes
  /// (native side: `aethel_core::wire::verify_projection`), then checks that
  /// the decoded projection's `tau` matches the padded form of `context`
  /// before running the same verification `plp-verify` does. This is the
  /// entry point a host can call knowing only bytes — no `plp-project-at-context`
  /// round trip, no hand-copied struct layout.
  ///
  /// Returns `ok(false)` for a well-formed but non-verifying pair, or one
  /// made for a different context, and `err` only for undecodable input.
  /// Additive: does not change `identity-error`'s variant ordinals.
  plp-verify-bytes: func(projection: list<u8>, proof: list<u8>, context: list<u8>) -> result<bool, identity-error>;

  /// Encode a typed `ephemeral-projection` as `aethel-plp-1` wire bytes, for
  /// callers that relay bytes rather than the typed record (A-4).
  ///
  /// No `result` in this signature: encoding a well-formed record cannot
  /// itself fail. A record whose `tau`/`salt` are not exactly 32 bytes, or
  /// whose `public-b` is not exactly `MODULE_K * RING_N` coefficients — which
  /// cannot happen to a record this world itself produced, only to one a
  /// caller hand-built with the wrong shape — encodes to an empty byte
  /// string, which is guaranteed to fail `plp-verify-bytes`/decode rather
  /// than silently succeeding on truncated or padded data.
  encode-projection: func(projection: ephemeral-projection) -> list<u8>;

  /// Encode a typed `zk-identity-proof` as `aethel-plp-1` wire bytes. See
  /// `encode-projection` for why this has no `result`.
  encode-proof: func(proof: zk-identity-proof) -> list<u8>;
}

interface secret-sharing {
  use types.{identity-error};

  /// A single threshold share of split key material.
  record htss-share {
    index: u8,
    value: list<u8>,
    /// Merkle inclusion path proving `(index, value)` is a genuine member of
    /// the tree named by the `root` returned alongside this share from
    /// `htss-split`. Flattened 32-byte hashes; length is a fixed function of
    /// `index` for this scheme's 5-share tree, so it carries no length
    /// prefix of its own.
    path: list<u8>,
  }

  /// Split key material into 5 Shamir shares (3-of-5 threshold), plus the
  /// 32-byte root that authenticates them as a set.
  ///
  /// Reconstruction checks every supplied share against a `root` (see
  /// `htss-reconstruct`), so a share list that was never produced by a real
  /// split is refused rather than silently interpolated into a value nobody
  /// ever shared. What this does not do is vouch for `root` itself: `root` is
  /// ordinary data once it leaves this call, and the guarantee is only as
  /// strong as the channel the caller uses to keep it — the same requirement
  /// verifying a signature places on the public key. Bundling `root` back
  /// together with the shares in one untrusted store defeats the point.
  htss-split: func(secret: list<u8>) -> result<tuple<list<htss-share>, list<u8>>, identity-error>;

  /// Reconstruct key material from threshold shares, authenticated against
  /// `root` from the matching `htss-split` call.
  ///
  /// Every supplied share's `path` is checked against `root` before
  /// interpolation runs; a share that does not check out, whatever its index
  /// or width, is refused as `invalid-share-set`. `root` must be 32 bytes.
  htss-reconstruct: func(shares: list<htss-share>, root: list<u8>) -> result<list<u8>, identity-error>;
}

world aethel-core {
  import types;

  export identity;
  export secret-sharing;
}
